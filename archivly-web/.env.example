# Same Supabase project as archivly-app -- only used here to insert into
# the public `waitlist` table (anon key, RLS allows insert-only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend (https://resend.com) -- sends the waitlist confirmation email.
# Server-only: no NEXT_PUBLIC_ prefix, never exposed to the browser.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Archivly <hello@archivly.app>"

# Plausible Analytics (https://plausible.io) -- set to the domain you added
# in your Plausible project. Leave unset to disable the analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=archivly.app

# Placeholder until the app is published -- update once there's a real listing.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.archivly.app

# ISO date the coming-soon countdown counts down to.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-01T00:00:00Z

# Feature flag: "true" serves the full marketing landing page at "/" instead
# of the coming-soon page. The full page is always viewable at /full
# regardless of this flag, for internal preview before flipping it on.
NEXT_PUBLIC_SHOW_FULL_LANDING=false
